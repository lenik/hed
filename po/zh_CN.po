#, c-format
msgid ""
"files examined: %zu\n"
"files changed:  %zu\n"
"replacements:   %zu\n"
"binary skipped: %zu\n"
msgstr ""
"检查的文件：     %zu\n"
"更改的文件：     %zu\n"
"替换次数：       %zu\n"
"跳过的二进制：   %zu\n"

#: src/repl.c:665
#, c-format
msgid "%zu file(s) changed, %zu replacement(s)\n"
msgstr "更改了 %zu 个文件，%zu 处替换\n"

