#: src/insert.c:45
msgid ""
"Usage: insert [OPTION]... FILE [SRC]...\n"
"Insert SRC content into FILE at a line position.\n"
"With -r, remove lines at the insert point (useful for delete/update).\n"
msgstr ""
"วิธีใช้: insert [ตัวเลือก]... ไฟล์ [แหล่ง]\n"
"แทรกเนื้อหาของแหล่งเข้าไปในไฟล์ที่ตำแหน่งบรรทัด\n"
"ใช้ -r เพื่อลบบรรทัดที่จุดแทรก (มีประโยชน์สำหรับการลบ/อัปเดต)\n"

#: src/insert.c:50
msgid "Source modes:\n"
msgstr "โหมดแหล่ง:\n"

#: src/insert.c:52
msgid "treat each SRC as a string literal\n"
msgstr "ถือว่าแต่ละแหล่งเป็นสตริงตัวอักษร\n"

#: src/insert.c:54
msgid "treat each SRC as a filename\n"
msgstr "ถือว่าแต่ละแหล่งเป็นชื่อไฟล์\n"

#: src/insert.c:56
msgid "@FILE or string (default)\n"
msgstr "@ไฟล์ หรือสตริง (ค่าเริ่มต้น)\n"

#: src/insert.c:58
msgid "Position:\n"
msgstr "ตำแหน่ง:\n"

#: src/insert.c:60
msgid "insert before 1-based line NUM (pads empty lines if needed)\n"
msgstr "แทรกก่อนบรรทัด NUM (นับจาก 1; เติมบรรทัดว่างหากจำเป็น)\n"

#: src/insert.c:62
msgid "digit cluster: -1 prepend, -0 prepend+blank, -N before line N\n"
msgstr "กลุ่มตัวเลข: -1 แทรกหน้าสุด, -0 แทรกหน้าสุด+บรรทัดว่าง, -N ก่อนบรรทัด N\n"

#: src/insert.c:64
msgid "append; -a0 like >> (end), -a1 insert before last line\n"
msgstr "ต่อท้าย; -a0 เหมือน >> (ท้าย), -a1 แทรกก่อนบรรทัดสุดท้าย\n"

#: src/insert.c:66
msgid "prepend to the start\n"
msgstr "แทรกที่จุดเริ่มต้น\n"

#: src/insert.c:68
msgid "remove NUM lines at the insert point before inserting\n"
msgstr "ลบ NUM บรรทัดที่จุดแทรกก่อนแทรก\n"

#: src/insert.c:70
msgid ""
"trailing blank lines after each SRC (default: 1 for strings, 0 for files)\n"
msgstr "บรรทัดว่างท้ายหลังแต่ละแหล่ง (ค่าเริ่มต้น: 1 สำหรับสตริง, 0 สำหรับไฟล์)\n"

#: src/insert.c:72
msgid "use TEXT when a source file is missing\n"
msgstr "ใช้ TEXT เมื่อไฟล์แหล่งหายไป\n"

#: src/insert.c:75
msgid "repeat for more verbose loggings\n"
msgstr "ทำซ้ำเพื่อบันทึกที่ละเอียดขึ้น\n"

#: src/insert.c:77
msgid "show less logging messages\n"
msgstr "แสดงข้อความบันทึกน้อยลง\n"

#: src/insert.c:79 src/repl.c:178
msgid "display this help and exit\n"
msgstr "แสดงความช่วยเหลือนี้แล้วออก\n"

#: src/insert.c:81 src/repl.c:180
msgid "output version information and exit\n"
msgstr "แสดงข้อมูลเวอร์ชันแล้วออก\n"

#: src/insert.c:83
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "รายงานข้อผิดพลาดที่: <%s>\n"

#: src/insert.c:292
#, c-format
msgid "%s: invalid remove count: %s\n"
msgstr "%s: จำนวนบรรทัดที่ลบไม่ถูกต้อง: %s\n"

#: src/insert.c:302
#, c-format
msgid "%s: invalid line number: %s\n"
msgstr "%s: หมายเลขบรรทัดไม่ถูกต้อง: %s\n"

#: src/insert.c:314
#, c-format
msgid "%s: invalid blank count: %s\n"
msgstr "%s: จำนวนบรรทัดว่างไม่ถูกต้อง: %s\n"

#: src/insert.c:338 src/repl.c:780
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "ลิขสิทธิ์ (C) %d %s\n"

#: src/insert.c:339 src/repl.c:781
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"สัญญาอนุญาต AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/insert.c:341
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "นี่คือซอฟต์แวร์เสรี: คุณมีสิทธิ์แก้ไขและแจกจ่ายต่อได้\n"

#: src/insert.c:343
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "โครงการนี้คัดค้านการแสวงหาผลประโยชน์จาก AI และอำนาจครอบงำของ AI\n"

#: src/insert.c:344
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"โครงการนี้ปฏิเสธสัญญาอนุญาตแบบ MIT โดยไม่ไตร่ตรอง และสัญญาอนุญาตแบบ BSD "
"ที่ไร้เดียงสาทางการเมือง\n"

#: src/insert.c:347
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "ไม่มีการรับประกันใด ๆ เท่าที่กฎหมายอนุญาต\n"

#: src/insert.c:372
#, c-format
msgid "%s: missing FILE\n"
msgstr "%s: ไม่มีไฟล์\n"

#: src/insert.c:413 src/insert.c:427 src/insert.c:540
#, c-format
msgid "%s: out of memory\n"
msgstr "%s: หน่วยความจำไม่พอ\n"

#: src/repl.c:94
msgid ""
"Usage: repl [OPTION]... PATTERN REPLACEMENT [FILE]...\n"
"       repl [OPTION]... -e PATTERN ... REPLACEMENT [FILE]...\n"
"Batch replace PATTERN with REPLACEMENT in files.\n"
"A file is rewritten only when its contents would change.\n"
"With no FILE, read standard input and write to standard output.\n"
msgstr ""
"วิธีใช้: repl [ตัวเลือก]... รูปแบบ สิ่งแทนที่ [ไฟล์]...\n"
"       repl [ตัวเลือก]... -e รูปแบบ ... สิ่งแทนที่ [ไฟล์]...\n"
"แทนที่รูปแบบด้วยสิ่งแทนที่ในไฟล์แบบเป็นชุด\n"
"จะเขียนไฟล์ใหม่เฉพาะเมื่อเนื้อหาจะเปลี่ยน\n"
"ถ้าไม่มีไฟล์ ให้อ่านอินพุตมาตรฐานและเขียนไปยังเอาต์พุตมาตรฐาน\n"

#: src/repl.c:101
msgid "Pattern selection (default: fixed strings):\n"
msgstr "การเลือกรูปแบบ (ค่าเริ่มต้น: สตริงคงที่):\n"

#: src/repl.c:103
msgid "interpret patterns as fixed strings (default)\n"
msgstr "ตีความรูปแบบเป็นสตริงคงที่ (ค่าเริ่มต้น)\n"

#: src/repl.c:105
msgid "interpret patterns as POSIX extended regular expressions\n"
msgstr "ตีความรูปแบบเป็นนิพจน์ปกติแบบขยายของ POSIX\n"

#: src/repl.c:107
msgid "interpret patterns as POSIX basic regular expressions\n"
msgstr "ตีความรูปแบบเป็นนิพจน์ปกติแบบพื้นฐานของ POSIX\n"

#: src/repl.c:109
msgid "interpret patterns as Perl-compatible regular expressions (PCRE2)\n"
msgstr "ตีความรูปแบบเป็นนิพจน์ปกติที่เข้ากันได้กับ Perl (PCRE2)\n"

#: src/repl.c:111
msgid "use PATTERNS; may be repeated; combine with -f\n"
msgstr "ใช้ PATTERNS; ระบุซ้ำได้; ใช้ร่วมกับ -f ได้\n"

#: src/repl.c:113
msgid "read patterns from FILE, one per line; - means standard input\n"
msgstr "อ่านรูปแบบจาก FILE ทีละบรรทัด; - หมายถึงอินพุตมาตรฐาน\n"

#: src/repl.c:115
msgid "ignore case distinctions in patterns and data\n"
msgstr "ไม่แยกแยะตัวพิมพ์ใหญ่-เล็กในรูปแบบและข้อมูล\n"

#: src/repl.c:117
msgid "do not ignore case (default); cancels a prior -i\n"
msgstr "แยกแยะตัวพิมพ์ใหญ่-เล็ก (ค่าเริ่มต้น); ยกเลิก -i ก่อนหน้า\n"

#: src/repl.c:119
msgid "replace each non-matching line entirely with REPLACEMENT\n"
msgstr "แทนที่ทั้งบรรทัดที่ไม่ตรงกันด้วย REPLACEMENT\n"

#: src/repl.c:121
msgid "match only whole words\n"
msgstr "จับคู่เฉพาะคำทั้งคำเท่านั้น\n"

#: src/repl.c:123
msgid "match only whole lines\n"
msgstr "จับคู่เฉพาะทั้งบรรทัดเท่านั้น\n"

#: src/repl.c:125
msgid "File selection:\n"
msgstr "การเลือกไฟล์:\n"

#: src/repl.c:127
msgid "recurse directories; follow symlinks only if on the command line\n"
msgstr "ไล่ดูไดเรกทอรีแบบเรียกซ้ำ; ตามลิงก์สัญลักษณ์เฉพาะเมื่ออยู่บนบรรทัดคำสั่ง\n"

#: src/repl.c:131
msgid "recurse directories, following all symbolic links\n"
msgstr "ไล่ดูไดเรกทอรีแบบเรียกซ้ำ โดยตามลิงก์สัญลักษณ์ทั้งหมด\n"

#: src/repl.c:133
msgid "limit directory recursion depth\n"
msgstr "จำกัดความลึกของการไล่ดูไดเรกทอรีแบบเรียกซ้ำ\n"

#: src/repl.c:135
msgid "skip files whose base name matches GLOB\n"
msgstr "ข้ามไฟล์ที่ชื่อฐานตรงกับ GLOB\n"

#: src/repl.c:137
msgid "read exclude globs from FILE, one per line\n"
msgstr "อ่าน glob ที่จะตัดออกจาก FILE ทีละบรรทัด\n"

#: src/repl.c:139
msgid "skip directories whose base name matches GLOB\n"
msgstr "ข้ามไดเรกทอรีที่ชื่อฐานตรงกับ GLOB\n"

#: src/repl.c:141
msgid "only process files whose base name matches GLOB\n"
msgstr "ประมวลผลเฉพาะไฟล์ที่ชื่อฐานตรงกับ GLOB\n"

#: src/repl.c:145
msgid "how to handle directories: repl (default), skip, or recurse\n"
msgstr "วิธีจัดการไดเรกทอรี: repl (ค่าเริ่มต้น), skip หรือ recurse\n"

#: src/repl.c:147
msgid "how to handle devices/FIFOs/sockets: repl (default) or skip\n"
msgstr "วิธีจัดการอุปกรณ์/FIFO/ซ็อกเก็ต: repl (ค่าเริ่มต้น) หรือ skip\n"

#: src/repl.c:149
msgid "binary (default: stop before non-printable), without-match, or text\n"
msgstr "binary (ค่าเริ่มต้น: หยุดก่อนอักขระที่พิมพ์ไม่ได้), without-match หรือ text\n"

#: src/repl.c:151
msgid "same as --binary-files=without-match\n"
msgstr "เหมือนกับ --binary-files=without-match\n"

#: src/repl.c:153
msgid "treat files as binary; disable the binary heuristic\n"
msgstr "ถือว่าไฟล์เป็นไบนารี; ปิดการเดาแบบไบนารี\n"

#: src/repl.c:155
msgid "treat input as NUL-terminated lines instead of newline-terminated\n"
msgstr "ถือว่าอินพุตเป็นบรรทัดที่จบด้วย NUL แทนการจบด้วยขึ้นบรรทัดใหม่\n"

#: src/repl.c:157
msgid "Reporting:\n"
msgstr "การรายงาน:\n"

#: src/repl.c:159
msgid ""
"show what would change; with -u/-c print diffs, but do not update files\n"
msgstr ""

#: src/repl.c:162
msgid "suppress the default one-line summary\n"
msgstr "ไม่แสดงสรุปหนึ่งบรรทัดตามค่าเริ่มต้น\n"

#: src/repl.c:164
msgid "print a context diff (diff -c) for each changed file\n"
msgstr "พิมพ์ diff แบบบริบท (diff -c) สำหรับแต่ละไฟล์ที่เปลี่ยน\n"

#: src/repl.c:166
msgid "print a unified diff (diff -u) for each changed file\n"
msgstr "พิมพ์ diff แบบรวม (diff -u) สำหรับแต่ละไฟล์ที่เปลี่ยน\n"

#: src/repl.c:168
msgid "print a detailed batch summary (files examined/changed, counts)\n"
msgstr "พิมพ์สรุปรายชุดแบบละเอียด (ไฟล์ที่ตรวจ/ที่เปลี่ยน, จำนวนครั้ง)\n"

#: src/repl.c:170
msgid ""
"color diffs; WHEN is never, always, or auto (default with --color: auto)\n"
msgstr ""

#: src/repl.c:173
msgid ""
"colors when --color is active; colon-separated terminfo/SGR list "
"(rs:hd:ad:de:ln)\n"
msgstr ""

