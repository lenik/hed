msgstr "%s: パターンと置換文字列がありません\n"

#: src/repl.c:586
#, c-format
msgid "%s: missing REPLACEMENT\n"
msgstr "%s: 置換文字列がありません\n"

#: src/repl.c:600
msgid "pattern error"
msgstr "パターンエラー"

#: src/repl.c:658
#, c-format
msgid ""
"files examined: %zu\n"
"files changed:  %zu\n"
"replacements:   %zu\n"
"binary skipped: %zu\n"
msgstr ""
"検査したファイル:     %zu\n"
"変更したファイル:     %zu\n"
"置換回数:             %zu\n"
"バイナリをスキップ:   %zu\n"

#: src/repl.c:665
#, c-format
msgid "%zu file(s) changed, %zu replacement(s)\n"
msgstr "%zu 個のファイルを変更、%zu 件の置換\n"

