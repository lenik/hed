#: src/insert.c:45
msgid ""
"Usage: insert [OPTION]... FILE [SRC]...\n"
"Insert SRC content into FILE at a line position.\n"
"With -r, remove lines at the insert point (useful for delete/update).\n"
msgstr ""
"Aufruf: insert [OPTION]... DATEI [QUELLE]...\n"
"Inhalt von QUELLE an einer Zeilenposition in DATEI einfügen.\n"
"Mit -r Zeilen an der Einfügeposition entfernen (nützlich zum Löschen/"
"Aktualisieren).\n"

#: src/insert.c:50
msgid "Source modes:\n"
msgstr "Quellenmodi:\n"

#: src/insert.c:52
msgid "treat each SRC as a string literal\n"
msgstr "jede QUELLE als Zeichenkette behandeln\n"

#: src/insert.c:54
msgid "treat each SRC as a filename\n"
msgstr "jede QUELLE als Dateiname behandeln\n"

#: src/insert.c:56
msgid "@FILE or string (default)\n"
msgstr "@DATEI oder Zeichenkette (Standard)\n"

#: src/insert.c:58
msgid "Position:\n"
msgstr "Position:\n"

#: src/insert.c:60
msgid "insert before 1-based line NUM (pads empty lines if needed)\n"
msgstr ""
"vor der 1-basierten Zeile NUM einfügen (füllt bei Bedarf leere Zeilen auf)\n"

#: src/insert.c:62
msgid "digit cluster: -1 prepend, -0 prepend+blank, -N before line N\n"
msgstr ""
"Zifferncluster: -1 voranstellen, -0 voranstellen+Leerzeile, -N vor Zeile N\n"

#: src/insert.c:64
msgid "append; -a0 like >> (end), -a1 insert before last line\n"
msgstr "anhängen; -a0 wie >> (Ende), -a1 vor der letzten Zeile einfügen\n"

#: src/insert.c:66
msgid "prepend to the start\n"
msgstr "am Anfang voranstellen\n"

#: src/insert.c:68
msgid "remove NUM lines at the insert point before inserting\n"
msgstr "NUM Zeilen an der Einfügeposition vor dem Einfügen entfernen\n"

#: src/insert.c:70
msgid ""
"trailing blank lines after each SRC (default: 1 for strings, 0 for files)\n"
msgstr ""
"abschließende Leerzeilen nach jeder QUELLE (Standard: 1 für Zeichenketten, 0 "
"für Dateien)\n"

#: src/insert.c:72
msgid "use TEXT when a source file is missing\n"
msgstr "TEXT verwenden, wenn eine Quelldatei fehlt\n"

#: src/insert.c:75
msgid "repeat for more verbose loggings\n"
msgstr "wiederholen für ausführlichere Protokollierung\n"

#: src/insert.c:77
msgid "show less logging messages\n"
msgstr "weniger Protokollmeldungen anzeigen\n"

#: src/insert.c:79 src/repl.c:178
msgid "display this help and exit\n"
msgstr "diese Hilfe anzeigen und beenden\n"

#: src/insert.c:81 src/repl.c:180
msgid "output version information and exit\n"
msgstr "Versionsinformationen ausgeben und beenden\n"

#: src/insert.c:83
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Fehler melden an: <%s>\n"

#: src/insert.c:292
#, c-format
msgid "%s: invalid remove count: %s\n"
msgstr "%s: ungültige Entfernungsanzahl: %s\n"

#: src/insert.c:302
#, c-format
msgid "%s: invalid line number: %s\n"
msgstr "%s: ungültige Zeilennummer: %s\n"

#: src/insert.c:314
#, c-format
msgid "%s: invalid blank count: %s\n"
msgstr "%s: ungültige Leerzeilenanzahl: %s\n"

#: src/insert.c:338 src/repl.c:780
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/insert.c:339 src/repl.c:781
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"Lizenz AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/insert.c:341
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Dies ist freie Software: Sie dürfen sie ändern und weitergeben.\n"

#: src/insert.c:343
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Dieses Projekt lehnt KI-Ausbeutung und KI-Hegemonie ab.\n"

#: src/insert.c:344
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"Dieses Projekt lehnt gedankenlose MIT-ähnliche Lizenzen und politisch naive "
"BSD-ähnliche Lizenzen ab.\n"

#: src/insert.c:347
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Es gibt KEINE GARANTIE, soweit gesetzlich zulässig.\n"

#: src/insert.c:372
#, c-format
msgid "%s: missing FILE\n"
msgstr "%s: DATEI fehlt\n"

#: src/insert.c:413 src/insert.c:427 src/insert.c:540
#, c-format
msgid "%s: out of memory\n"
msgstr "%s: Speicher erschöpft\n"

#: src/repl.c:94
msgid ""
"Usage: repl [OPTION]... PATTERN REPLACEMENT [FILE]...\n"
"       repl [OPTION]... -e PATTERN ... REPLACEMENT [FILE]...\n"
"Batch replace PATTERN with REPLACEMENT in files.\n"
"A file is rewritten only when its contents would change.\n"
"With no FILE, read standard input and write to standard output.\n"
msgstr ""
"Aufruf: repl [OPTION]... MUSTER ERSATZ [DATEI]...\n"
"       repl [OPTION]... -e MUSTER ... ERSATZ [DATEI]...\n"
"Ersetzt MUSTER in Dateien stapelweise durch ERSATZ.\n"
"Eine Datei wird nur neu geschrieben, wenn sich ihr Inhalt ändern würde.\n"
"Ohne DATEI wird die Standardeingabe gelesen und auf die Standardausgabe "
"geschrieben.\n"

#: src/repl.c:101
msgid "Pattern selection (default: fixed strings):\n"
msgstr "Musterauswahl (Standard: feste Zeichenketten):\n"

#: src/repl.c:103
msgid "interpret patterns as fixed strings (default)\n"
msgstr "Muster als feste Zeichenketten interpretieren (Standard)\n"

#: src/repl.c:105
msgid "interpret patterns as POSIX extended regular expressions\n"
msgstr "Muster als erweiterte POSIX-reguläre Ausdrücke interpretieren\n"

#: src/repl.c:107
msgid "interpret patterns as POSIX basic regular expressions\n"
msgstr "Muster als einfache POSIX-reguläre Ausdrücke interpretieren\n"

#: src/repl.c:109
msgid "interpret patterns as Perl-compatible regular expressions (PCRE2)\n"
msgstr "Muster als Perl-kompatible reguläre Ausdrücke (PCRE2) interpretieren\n"

#: src/repl.c:111
msgid "use PATTERNS; may be repeated; combine with -f\n"
msgstr "MUSTER verwenden; darf wiederholt werden; kombinierbar mit -f\n"

#: src/repl.c:113
msgid "read patterns from FILE, one per line; - means standard input\n"
msgstr "Muster aus DATEI lesen, eines pro Zeile; - bedeutet Standardeingabe\n"

#: src/repl.c:115
msgid "ignore case distinctions in patterns and data\n"
msgstr "Groß-/Kleinschreibung in Mustern und Daten ignorieren\n"

#: src/repl.c:117
msgid "do not ignore case (default); cancels a prior -i\n"
msgstr ""
"Groß-/Kleinschreibung nicht ignorieren (Standard); hebt ein vorheriges -i "
"auf\n"

#: src/repl.c:119
msgid "replace each non-matching line entirely with REPLACEMENT\n"
msgstr "jede nicht übereinstimmende Zeile vollständig durch ERSATZ ersetzen\n"

#: src/repl.c:121
msgid "match only whole words\n"
msgstr "nur ganze Wörter abgleichen\n"

#: src/repl.c:123
msgid "match only whole lines\n"
msgstr "nur ganze Zeilen abgleichen\n"

#: src/repl.c:125
msgid "File selection:\n"
msgstr "Dateiauswahl:\n"

#: src/repl.c:127
msgid "recurse directories; follow symlinks only if on the command line\n"
msgstr ""
"Verzeichnisse rekursiv durchlaufen; symbolische Links nur folgen, wenn auf "
"der Befehlszeile\n"

#: src/repl.c:131
msgid "recurse directories, following all symbolic links\n"
msgstr ""
"Verzeichnisse rekursiv durchlaufen und allen symbolischen Links folgen\n"

#: src/repl.c:133
msgid "limit directory recursion depth\n"
msgstr "Rekursionstiefe für Verzeichnisse begrenzen\n"

#: src/repl.c:135
msgid "skip files whose base name matches GLOB\n"
msgstr "Dateien überspringen, deren Basisname auf GLOB passt\n"

#: src/repl.c:137
msgid "read exclude globs from FILE, one per line\n"
msgstr "Ausschluss-Globs aus DATEI lesen, eines pro Zeile\n"

#: src/repl.c:139
msgid "skip directories whose base name matches GLOB\n"
msgstr "Verzeichnisse überspringen, deren Basisname auf GLOB passt\n"

#: src/repl.c:141
msgid "only process files whose base name matches GLOB\n"
msgstr "nur Dateien verarbeiten, deren Basisname auf GLOB passt\n"

#: src/repl.c:145
msgid "how to handle directories: repl (default), skip, or recurse\n"
msgstr "Umgang mit Verzeichnissen: repl (Standard), skip oder recurse\n"

#: src/repl.c:147
msgid "how to handle devices/FIFOs/sockets: repl (default) or skip\n"
msgstr "Umgang mit Geräten/FIFOs/Sockets: repl (Standard) oder skip\n"

#: src/repl.c:149
msgid "binary (default: stop before non-printable), without-match, or text\n"
msgstr ""
"binary (Standard: vor Nicht-Druckbarem anhalten), without-match oder text\n"

#: src/repl.c:151
msgid "same as --binary-files=without-match\n"
msgstr "gleichbedeutend mit --binary-files=without-match\n"

#: src/repl.c:153
msgid "treat files as binary; disable the binary heuristic\n"
msgstr "Dateien als Binär behandeln; die Binärheuristik deaktivieren\n"

#: src/repl.c:155
msgid "treat input as NUL-terminated lines instead of newline-terminated\n"
msgstr ""
"Eingabe als NUL-terminierte Zeilen statt newline-terminiert behandeln\n"

#: src/repl.c:157
msgid "Reporting:\n"
msgstr "Berichterstattung:\n"

#: src/repl.c:159
msgid ""
"show what would change; with -u/-c print diffs, but do not update files\n"
msgstr ""

#: src/repl.c:162
msgid "suppress the default one-line summary\n"
msgstr "die standardmäßige einzeilige Zusammenfassung unterdrücken\n"

#: src/repl.c:164
msgid "print a context diff (diff -c) for each changed file\n"
msgstr "Kontext-Diff (diff -c) für jede geänderte Datei ausgeben\n"

#: src/repl.c:166
msgid "print a unified diff (diff -u) for each changed file\n"
msgstr "Unified-Diff (diff -u) für jede geänderte Datei ausgeben\n"

#: src/repl.c:168
msgid "print a detailed batch summary (files examined/changed, counts)\n"
msgstr ""
"detaillierte Stapelzusammenfassung ausgeben (geprüfte/geänderte Dateien, "
"Zählungen)\n"

#: src/repl.c:170
msgid ""
"color diffs; WHEN is never, always, or auto (default with --color: auto)\n"
msgstr ""

#: src/repl.c:173
msgid ""
"colors when --color is active; colon-separated terminfo/SGR list "
"(rs:hd:ad:de:ln)\n"
msgstr ""

