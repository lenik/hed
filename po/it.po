#: src/insert.c:45
msgid ""
"Usage: insert [OPTION]... FILE [SRC]...\n"
"Insert SRC content into FILE at a line position.\n"
"With -r, remove lines at the insert point (useful for delete/update).\n"
msgstr ""
"Uso: insert [OPZIONE]... FILE [SORGENTE]...\n"
"Inserisce il contenuto di SORGENTE in FILE a una posizione di riga.\n"
"Con -r, rimuove le righe nel punto di inserimento (utile per eliminare/"
"aggiornare).\n"

#: src/insert.c:50
msgid "Source modes:\n"
msgstr "Modalità sorgente:\n"

#: src/insert.c:52
msgid "treat each SRC as a string literal\n"
msgstr "tratta ogni SORGENTE come stringa letterale\n"

#: src/insert.c:54
msgid "treat each SRC as a filename\n"
msgstr "tratta ogni SORGENTE come nome di file\n"

#: src/insert.c:56
msgid "@FILE or string (default)\n"
msgstr "@FILE o stringa (predefinito)\n"

#: src/insert.c:58
msgid "Position:\n"
msgstr "Posizione:\n"

#: src/insert.c:60
msgid "insert before 1-based line NUM (pads empty lines if needed)\n"
msgstr ""
"inserisce prima della riga NUM (numerazione da 1; aggiunge righe vuote se "
"necessario)\n"

#: src/insert.c:62
msgid "digit cluster: -1 prepend, -0 prepend+blank, -N before line N\n"
msgstr ""
"gruppo di cifre: -1 antepone, -0 antepone+riga vuota, -N prima della riga N\n"

#: src/insert.c:64
msgid "append; -a0 like >> (end), -a1 insert before last line\n"
msgstr ""
"aggiunge in coda; -a0 come >> (fine), -a1 inserisce prima dell'ultima riga\n"

#: src/insert.c:66
msgid "prepend to the start\n"
msgstr "antepone all'inizio\n"

#: src/insert.c:68
msgid "remove NUM lines at the insert point before inserting\n"
msgstr "rimuove NUM righe nel punto di inserimento prima di inserire\n"

#: src/insert.c:70
msgid ""
"trailing blank lines after each SRC (default: 1 for strings, 0 for files)\n"
msgstr ""
"righe vuote finali dopo ogni SORGENTE (predefinito: 1 per stringhe, 0 per "
"file)\n"

#: src/insert.c:72
msgid "use TEXT when a source file is missing\n"
msgstr "usa TESTO quando manca un file sorgente\n"

#: src/insert.c:75
msgid "repeat for more verbose loggings\n"
msgstr "ripetere per registrazioni più dettagliate\n"

#: src/insert.c:77
msgid "show less logging messages\n"
msgstr "mostra meno messaggi di registro\n"

#: src/insert.c:79 src/repl.c:178
msgid "display this help and exit\n"
msgstr "mostra questo aiuto ed esce\n"

#: src/insert.c:81 src/repl.c:180
msgid "output version information and exit\n"
msgstr "mostra le informazioni sulla versione ed esce\n"

#: src/insert.c:83
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Segnalare i bug a: <%s>\n"

#: src/insert.c:292
#, c-format
msgid "%s: invalid remove count: %s\n"
msgstr "%s: conteggio di rimozione non valido: %s\n"

#: src/insert.c:302
#, c-format
msgid "%s: invalid line number: %s\n"
msgstr "%s: numero di riga non valido: %s\n"

#: src/insert.c:314
#, c-format
msgid "%s: invalid blank count: %s\n"
msgstr "%s: conteggio di righe vuote non valido: %s\n"

#: src/insert.c:338 src/repl.c:780
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/insert.c:339 src/repl.c:781
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"Licenza AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/insert.c:341
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr ""
"Questo è software libero: siete liberi di modificarlo e ridistribuirlo.\n"

#: src/insert.c:343
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr ""
"Questo progetto si oppone allo sfruttamento dell'IA e all'egemonia dell'IA.\n"

#: src/insert.c:344
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"Questo progetto rifiuta le licenze in stile MIT senza riflessione e le "
"licenze in stile BSD politicamente ingenue.\n"

#: src/insert.c:347
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Non vi è ALCUNA GARANZIA, nei limiti consentiti dalla legge.\n"

#: src/insert.c:372
#, c-format
msgid "%s: missing FILE\n"
msgstr "%s: FILE mancante\n"

#: src/insert.c:413 src/insert.c:427 src/insert.c:540
#, c-format
msgid "%s: out of memory\n"
msgstr "%s: memoria esaurita\n"

#: src/repl.c:94
msgid ""
"Usage: repl [OPTION]... PATTERN REPLACEMENT [FILE]...\n"
"       repl [OPTION]... -e PATTERN ... REPLACEMENT [FILE]...\n"
"Batch replace PATTERN with REPLACEMENT in files.\n"
"A file is rewritten only when its contents would change.\n"
"With no FILE, read standard input and write to standard output.\n"
msgstr ""
"Uso: repl [OPZIONE]... MODELLO SOSTITUZIONE [FILE]...\n"
"       repl [OPZIONE]... -e MODELLO ... SOSTITUZIONE [FILE]...\n"
"Sostituisce in blocco MODELLO con SOSTITUZIONE nei file.\n"
"Un file viene riscritto solo se il suo contenuto cambierebbe.\n"
"Senza FILE, legge l'ingresso standard e scrive sull'uscita standard.\n"

#: src/repl.c:101
msgid "Pattern selection (default: fixed strings):\n"
msgstr "Selezione dei modelli (predefinito: stringhe fisse):\n"

#: src/repl.c:103
msgid "interpret patterns as fixed strings (default)\n"
msgstr "interpreta i modelli come stringhe fisse (predefinito)\n"

#: src/repl.c:105
msgid "interpret patterns as POSIX extended regular expressions\n"
msgstr "interpreta i modelli come espressioni regolari estese POSIX\n"

#: src/repl.c:107
msgid "interpret patterns as POSIX basic regular expressions\n"
msgstr "interpreta i modelli come espressioni regolari di base POSIX\n"

#: src/repl.c:109
msgid "interpret patterns as Perl-compatible regular expressions (PCRE2)\n"
msgstr ""
"interpreta i modelli come espressioni regolari compatibili con Perl (PCRE2)\n"

#: src/repl.c:111
msgid "use PATTERNS; may be repeated; combine with -f\n"
msgstr "usa MODELLI; può essere ripetuto; combinabile con -f\n"

#: src/repl.c:113
msgid "read patterns from FILE, one per line; - means standard input\n"
msgstr "legge i modelli da FILE, uno per riga; - indica l'ingresso standard\n"

#: src/repl.c:115
msgid "ignore case distinctions in patterns and data\n"
msgstr "ignora le distinzioni di maiuscole/minuscole nei modelli e nei dati\n"

#: src/repl.c:117
msgid "do not ignore case (default); cancels a prior -i\n"
msgstr ""
"non ignorare maiuscole/minuscole (predefinito); annulla un -i precedente\n"

#: src/repl.c:119
msgid "replace each non-matching line entirely with REPLACEMENT\n"
msgstr ""
"sostituisce interamente ogni riga non corrispondente con SOSTITUZIONE\n"

#: src/repl.c:121
msgid "match only whole words\n"
msgstr "corrisponde solo a parole intere\n"

#: src/repl.c:123
msgid "match only whole lines\n"
msgstr "corrisponde solo a righe intere\n"

#: src/repl.c:125
msgid "File selection:\n"
msgstr "Selezione file:\n"

#: src/repl.c:127
msgid "recurse directories; follow symlinks only if on the command line\n"
msgstr ""
"scorre le directory ricorsivamente; segue i collegamenti simbolici solo se "
"sulla riga di comando\n"

#: src/repl.c:131
msgid "recurse directories, following all symbolic links\n"
msgstr ""
"scorre le directory ricorsivamente, seguendo tutti i collegamenti simbolici\n"

#: src/repl.c:133
msgid "limit directory recursion depth\n"
msgstr "limita la profondità di ricorsione delle directory\n"

#: src/repl.c:135
msgid "skip files whose base name matches GLOB\n"
msgstr "salta i file il cui nome base corrisponde a GLOB\n"

#: src/repl.c:137
msgid "read exclude globs from FILE, one per line\n"
msgstr "legge i glob di esclusione da FILE, uno per riga\n"

#: src/repl.c:139
msgid "skip directories whose base name matches GLOB\n"
msgstr "salta le directory il cui nome base corrisponde a GLOB\n"

#: src/repl.c:141
msgid "only process files whose base name matches GLOB\n"
msgstr "elabora solo i file il cui nome base corrisponde a GLOB\n"

#: src/repl.c:145
msgid "how to handle directories: repl (default), skip, or recurse\n"
msgstr "come gestire le directory: repl (predefinito), skip o recurse\n"

#: src/repl.c:147
msgid "how to handle devices/FIFOs/sockets: repl (default) or skip\n"
msgstr "come gestire dispositivi/FIFO/socket: repl (predefinito) o skip\n"

#: src/repl.c:149
msgid "binary (default: stop before non-printable), without-match, or text\n"
msgstr ""
"binary (predefinito: fermarsi prima dei non stampabili), without-match o "
"text\n"

#: src/repl.c:151
msgid "same as --binary-files=without-match\n"
msgstr "uguale a --binary-files=without-match\n"

#: src/repl.c:153
msgid "treat files as binary; disable the binary heuristic\n"
msgstr "tratta i file come binari; disabilita l'euristica binaria\n"

#: src/repl.c:155
msgid "treat input as NUL-terminated lines instead of newline-terminated\n"
msgstr "tratta l'ingresso come righe terminate da NUL invece che da newline\n"

#: src/repl.c:157
msgid "Reporting:\n"
msgstr "Resoconto:\n"

#: src/repl.c:159
msgid ""
"show what would change; with -u/-c print diffs, but do not update files\n"
msgstr ""

#: src/repl.c:162
msgid "suppress the default one-line summary\n"
msgstr "sopprime il riepilogo predefinito di una riga\n"

#: src/repl.c:164
msgid "print a context diff (diff -c) for each changed file\n"
msgstr "stampa un diff contestuale (diff -c) per ogni file modificato\n"

#: src/repl.c:166
msgid "print a unified diff (diff -u) for each changed file\n"
msgstr "stampa un diff unificato (diff -u) per ogni file modificato\n"

#: src/repl.c:168
msgid "print a detailed batch summary (files examined/changed, counts)\n"
msgstr ""
"stampa un riepilogo dettagliato del lotto (file esaminati/modificati, "
"conteggi)\n"

#: src/repl.c:170
msgid ""
"color diffs; WHEN is never, always, or auto (default with --color: auto)\n"
msgstr ""

#: src/repl.c:173
msgid ""
"colors when --color is active; colon-separated terminfo/SGR list "
"(rs:hd:ad:de:ln)\n"
msgstr ""

