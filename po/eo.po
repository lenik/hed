#: src/insert.c:45
msgid ""
"Usage: insert [OPTION]... FILE [SRC]...\n"
"Insert SRC content into FILE at a line position.\n"
"With -r, remove lines at the insert point (useful for delete/update).\n"
msgstr ""
"Uzo: insert [OPCIO]... DOSIERO [FONTO]...\n"
"Enmeti enhavon de FONTO en DOSIEROn ĉe linia pozicio.\n"
"Kun -r, forigu liniojn ĉe la enmetpunkto (utila por forigo/ĝisdatigo).\n"

#: src/insert.c:50
msgid "Source modes:\n"
msgstr "Fontaj reĝimoj:\n"

#: src/insert.c:52
msgid "treat each SRC as a string literal\n"
msgstr "trakti ĉiun FONTOn kiel literalan ĉenon\n"

#: src/insert.c:54
msgid "treat each SRC as a filename\n"
msgstr "trakti ĉiun FONTOn kiel dosiernomon\n"

#: src/insert.c:56
msgid "@FILE or string (default)\n"
msgstr "@DOSIERO aŭ ĉeno (defaŭlto)\n"

#: src/insert.c:58
msgid "Position:\n"
msgstr "Pozicio:\n"

#: src/insert.c:60
msgid "insert before 1-based line NUM (pads empty lines if needed)\n"
msgstr ""
"enmeti antaŭ 1-bazita linio NUM (aldonas malplenajn liniojn se necese)\n"

#: src/insert.c:62
msgid "digit cluster: -1 prepend, -0 prepend+blank, -N before line N\n"
msgstr "cifera grupo: -1 antaŭmeti, -0 antaŭmeti+malplena, -N antaŭ linio N\n"

#: src/insert.c:64
msgid "append; -a0 like >> (end), -a1 insert before last line\n"
msgstr "aldoni; -a0 kiel >> (fino), -a1 enmeti antaŭ la lasta linio\n"

#: src/insert.c:66
msgid "prepend to the start\n"
msgstr "antaŭmeti ĉe la komenco\n"

#: src/insert.c:68
msgid "remove NUM lines at the insert point before inserting\n"
msgstr "forigi NUM liniojn ĉe la enmetpunkto antaŭ enmeto\n"

#: src/insert.c:70
msgid ""
"trailing blank lines after each SRC (default: 1 for strings, 0 for files)\n"
msgstr ""
"finaj malplenaj linioj post ĉiu FONTO (defaŭlte: 1 por ĉenoj, 0 por "
"dosieroj)\n"

#: src/insert.c:72
msgid "use TEXT when a source file is missing\n"
msgstr "uzi TEKSTOn kiam fonta dosiero mankas\n"

#: src/insert.c:75
msgid "repeat for more verbose loggings\n"
msgstr "ripeti por pli detalaj protokoloj\n"

#: src/insert.c:77
msgid "show less logging messages\n"
msgstr "montri malpli da protokolaj mesaĝoj\n"

#: src/insert.c:79 src/repl.c:147
msgid "display this help and exit\n"
msgstr "montri ĉi tiun helpon kaj eliri\n"

#: src/insert.c:81 src/repl.c:149
msgid "output version information and exit\n"
msgstr "eligi versiajn informojn kaj eliri\n"

#: src/insert.c:83
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Raportu cimojn al: <%s>\n"

#: src/insert.c:292
#, c-format
msgid "%s: invalid remove count: %s\n"
msgstr "%s: nevalida foriga nombro: %s\n"

#: src/insert.c:302
#, c-format
msgid "%s: invalid line number: %s\n"
msgstr "%s: nevalida linia numero: %s\n"

#: src/insert.c:314
#, c-format
msgid "%s: invalid blank count: %s\n"
msgstr "%s: nevalida nombro de malplenaj linioj: %s\n"

#: src/insert.c:338 src/repl.c:559
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Kopirajto (C) %d %s\n"

#: src/insert.c:339 src/repl.c:560
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"Permesilo AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/insert.c:341
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Ĉi tio estas libera programaro: vi rajtas ŝanĝi kaj redistribui ĝin.\n"

#: src/insert.c:343
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Ĉi tiu projekto kontraŭas AI-ekspluatadon kaj AI-hegemonion.\n"

#: src/insert.c:344
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"Ĉi tiu projekto rifuzas senpensan MIT-stilan permesilon kaj politike naivan "
"BSD-stilan permesilon.\n"

#: src/insert.c:347
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Estas NENIU GARANTIO, laŭlonge de tio, kion permesas la leĝo.\n"

#: src/insert.c:372
#, c-format
msgid "%s: missing FILE\n"
msgstr "%s: mankas DOSIERO\n"

#: src/insert.c:413 src/insert.c:427 src/insert.c:526
#, c-format
msgid "%s: out of memory\n"
msgstr "%s: memoro elĉerpita\n"

#: src/repl.c:73
msgid ""
"Usage: repl [OPTION]... PATTERN REPLACEMENT [FILE]...\n"
"       repl [OPTION]... -e PATTERN ... REPLACEMENT [FILE]...\n"
"Batch replace PATTERN with REPLACEMENT in files.\n"
"A file is rewritten only when its contents would change.\n"
"With no FILE, read standard input and write to standard output.\n"
msgstr ""
"Uzo: repl [OPCIO]... ŜABLONO ANSTAŬAĴO [DOSIERO]...\n"
"       repl [OPCIO]... -e ŜABLONO ... ANSTAŬAĴO [DOSIERO]...\n"
"Stape anstataŭigas ŜABLONON per ANSTAŬAĴO en dosieroj.\n"
"Dosiero estas reskribita nur kiam ĝia enhavo ŝanĝiĝus.\n"
"Sen DOSIERO, legas normalan enigon kaj skribas al normala eligo.\n"

#: src/repl.c:80
msgid "Pattern selection (default: fixed strings):\n"
msgstr "Elekto de ŝablono (defaŭlto: fiksitaj ĉenoj):\n"

#: src/repl.c:82
msgid "interpret patterns as fixed strings (default)\n"
msgstr "interpreti ŝablonojn kiel fiksitajn ĉenojn (defaŭlto)\n"

#: src/repl.c:84
msgid "interpret patterns as POSIX extended regular expressions\n"
msgstr "interpreti ŝablonojn kiel etenditajn regulajn esprimojn de POSIX\n"

#: src/repl.c:86
msgid "interpret patterns as POSIX basic regular expressions\n"
msgstr "interpreti ŝablonojn kiel bazajn regulajn esprimojn de POSIX\n"

#: src/repl.c:88
msgid "interpret patterns as Perl-compatible regular expressions (PCRE2)\n"
msgstr "interpreti ŝablonojn kiel Perl-kongruajn regulajn esprimojn (PCRE2)\n"

#: src/repl.c:90
msgid "use PATTERNS; may be repeated; combine with -f\n"
msgstr "uzi ŜABLONOJN; rajtas ripetiĝi; kombinebla kun -f\n"

#: src/repl.c:92
msgid "read patterns from FILE, one per line; - means standard input\n"
msgstr "legi ŝablonojn el DOSIERO, unu po linio; - signifas normalan enigon\n"

#: src/repl.c:94
msgid "ignore case distinctions in patterns and data\n"
msgstr "ignori usklecon en ŝablonoj kaj datumoj\n"

#: src/repl.c:96
msgid "do not ignore case (default); cancels a prior -i\n"
msgstr "ne ignori usklecon (defaŭlto); nuligas antaŭan -i\n"

#: src/repl.c:98
msgid "replace each non-matching line entirely with REPLACEMENT\n"
msgstr "anstataŭigi ĉiun nekongruan linion tute per ANSTAŬAĴO\n"

#: src/repl.c:100
msgid "match only whole words\n"
msgstr "kongrui nur kun tutaj vortoj\n"

#: src/repl.c:102
msgid "match only whole lines\n"
msgstr "kongrui nur kun tutaj linioj\n"

#: src/repl.c:104
msgid "File selection:\n"
msgstr "Dosiera elekto:\n"

#: src/repl.c:106
msgid "recurse directories; follow symlinks only if on the command line\n"
msgstr ""
"rekursi dosierujojn; sekvi simbolajn ligilojn nur se sur la komandlinio\n"

#: src/repl.c:110
msgid "recurse directories, following all symbolic links\n"
msgstr "rekursi dosierujojn, sekvante ĉiujn simbolajn ligilojn\n"

#: src/repl.c:112
msgid "limit directory recursion depth\n"
msgstr "limigi profundon de dosieruja rekursado\n"

#: src/repl.c:114
msgid "skip files whose base name matches GLOB\n"
msgstr "pretersalti dosierojn kies baza nomo kongruas kun GLOB\n"

#: src/repl.c:116
msgid "read exclude globs from FILE, one per line\n"
msgstr "legi ekskludajn globojn el DOSIERO, unu po linio\n"

#: src/repl.c:118
msgid "skip directories whose base name matches GLOB\n"
msgstr "pretersalti dosierujojn kies baza nomo kongruas kun GLOB\n"

#: src/repl.c:120
msgid "only process files whose base name matches GLOB\n"
msgstr "prilabori nur dosierojn kies baza nomo kongruas kun GLOB\n"

#: src/repl.c:124
msgid "how to handle directories: repl (default), skip, or recurse\n"
msgstr "kiel trakti dosierujojn: repl (defaŭlto), skip aŭ recurse\n"

#: src/repl.c:126
msgid "how to handle devices/FIFOs/sockets: repl (default) or skip\n"
msgstr "kiel trakti aparojn/FIFO-ojn/soklojn: repl (defaŭlto) aŭ skip\n"

#: src/repl.c:128
msgid "binary (default: stop before non-printable), without-match, or text\n"
msgstr "binary (defaŭlto: halti antaŭ nepreseblaj), without-match aŭ text\n"

#: src/repl.c:130
msgid "same as --binary-files=without-match\n"
msgstr "samas kiel --binary-files=without-match\n"

#: src/repl.c:132
msgid "treat files as binary; disable the binary heuristic\n"
msgstr "trakti dosierojn kiel binarajn; malŝalti la binaran heŭristikon\n"

#: src/repl.c:134
msgid "treat input as NUL-terminated lines instead of newline-terminated\n"
msgstr "trakti enigon kiel NUL-finajn liniojn anstataŭ novlini-finajn\n"

#: src/repl.c:136
msgid "Reporting:\n"
msgstr "Raportado:\n"

#: src/repl.c:138
msgid "suppress the default one-line summary\n"
msgstr "subpremi la defaŭltan unulinian resumon\n"

#: src/repl.c:140
msgid "print a context diff (diff -c) for each changed file\n"
msgstr "presi kuntekstan diferencigon (diff -c) por ĉiu ŝanĝita dosiero\n"

#: src/repl.c:142
msgid "print a unified diff (diff -u) for each changed file\n"
msgstr "presi unuigitan diferencigon (diff -u) por ĉiu ŝanĝita dosiero\n"

#: src/repl.c:144
msgid "print a detailed batch summary (files examined/changed, counts)\n"
msgstr ""
"presi detalan stapan resumon (ekzamenitaj/ŝanĝitaj dosieroj, kalkuloj)\n"

